# MailSentinel AI Configuration

API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
ENVIRONMENT=development

# Google Gemini AI Configuration (Primary Copilot LLM - Server-Side Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Hugging Face Configuration (Server-Side Only)
HF_TOKEN=
HF_MODEL_ID=openai/gpt-oss-20b

# Database Connection
DATABASE_URL=sqlite+aiosqlite:///./mailsentinel.db

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Security & Limits
MAX_EMAIL_BODY_LENGTH=1000000
MAX_AGENT_STEPS=5

# Enterprise Clerk Authentication & Google OAuth (Phase 5.1)
# Frontend Publishable Key (Safe to expose to browser client)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Backend Secret Key & Token Verification (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND OR GIT)
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]


